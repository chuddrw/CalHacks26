// tsconfig.base.json
//
// WHAT IT'S FOR
//   TypeScript settings shared by every Node package in repo 1 (hooks, mcp, watcher, scripts).
//   Each package's tsconfig.json extends this file. The UI overrides a few options for the browser.
//
// WHY THESE OPTIONS
//   Node 24 runs .ts files directly by stripping the types. That only works when:
//     - imports of our own files include the ".ts" extension  (allowImportingTsExtensions)
//     - the code uses no TS-only runtime syntax: no enums, no namespaces,
//       no constructor parameter properties                    (erasableSyntaxOnly)
//   So `node hooks/src/stop.ts` works with no build step, which keeps the hooks fast.
//   tsc is only used to type-check (noEmit). Run `npm run typecheck` from the root.
//
// OWNER: C. Change it only if everyone agrees.
{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  }
}
