// hooks/tsconfig.json
//
// WHAT IT'S FOR
//   Type-checks the hooks with the shared Node settings (tsconfig.base.json). The hooks are
//   never compiled: Node runs the .ts files directly. Run `npm run typecheck` from the root.
//
// OWNER: A.
{
  "extends": "../tsconfig.base.json",
  "include": ["src/**/*.ts", "test/**/*.ts", "../shared/src/**/*.ts", "../scripts/mock-stdb.ts", "../scripts/doctor.ts", "../scripts/live-e2e.ts"]
}
