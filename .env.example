# .env.example
#
# WHAT IT'S FOR
#   Lists every setting and key the Node code reads (hooks, MCP server, watcher, scripts).
#   Copy it to .env in this folder on each laptop and fill in the values. Never commit .env.
#   shared/src/config.ts loads it. The UI reads only the VITE_ lines (vite.config.ts points
#   Vite at this folder). Where each key comes from: external/api-keys.txt.

# ---- Who am I (different on every laptop) ------------------------------------------
# Lowercase, no spaces. Used in wip/<name>, the agent table and every inbox row.
COWORK_NAME=

# ---- SpacetimeDB (external/spacetimedb-maincloud.txt) -------------------------------
STDB_HOST=https://maincloud.spacetimedb.com
# Database name, the same on every laptop. Part C published it as agent-cowork.
STDB_DB=agent-cowork
# There is deliberately no token here. Part C's rules (module/ACCESS.md): every tool authenticates
# as your own `spacetime login` session (shared/src/session-token.ts), and the database owner
# approves your public identity. `npm run doctor` checks both.
# Working without a server: `npm run mock-db`, then run tools with these in the process
# environment (not in this file): STDB_HOST=http://127.0.0.1:3077 STDB_DB=mock STDB_TOKEN=anything

# ---- Git ----------------------------------------------------------------------------
GIT_REMOTE=origin
MAIN_BRANCH=main

# ---- Hooks --------------------------------------------------------------------------
# How long the newest listener waits for a conflict before exiting (minutes). Keep it below
# the asyncRewake timeout that install.ts writes (30 minutes).
LISTENER_MINUTES=25
# 1 = hooks print their own errors to stderr (shown with claude --debug). Leave at 0 for demos.
COWORK_DEBUG=0

# ---- Watcher only -------------------------------------------------------------------
# Absolute path to a separate clone of demo-app that only the watcher uses for worktrees.
# Don't point it at a clone someone is coding in. Run `npm install --no-save typescript@7 vitest@5`
# in it once: the watcher links its node_modules into every worktree.
DEMO_REPO_PATH=
CHECK_DEBOUNCE_MS=2000

# ---- Diagnosis (watcher only) ---------------------------------------------------------
# droid | claude. Droid is the Factory prize path; claude is the fallback.
DIAGNOSE_WITH=droid
FACTORY_API_KEY=
# Leave empty to use Droid's default. Run listModels() once to see what our account can pick.
DROID_MODEL_ID=
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---- UI (Vite only exposes variables that start with VITE_) --------------------------
VITE_STDB_HOST=https://maincloud.spacetimedb.com
VITE_STDB_DB=
# Optional display label for the repository being monitored (not the tool's own repository).
VITE_PROJECT_LABEL=
