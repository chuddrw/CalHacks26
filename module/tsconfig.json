// module/tsconfig.json
//
// WHAT IT'S FOR
//   TypeScript settings for the SpacetimeDB module. The spacetime CLI bundles module/src/index.ts
//   itself, so tsc only type-checks here. target, lib, module, isolatedModules and noEmit are the
//   values `spacetime init --lang typescript` marks as required by SpacetimeDB; keep them.
//
// OWNER: C.
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
